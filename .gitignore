# ==============================================================================
# Git Ignore Configuration - Student Task Manager IaC
# Security First: Prevent credential leakage and ephemeral artifact commits
# ==============================================================================

# Terraform State files (contain sensitive infrastructure metadata and outputs)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform runtime cache & crash logs
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log

# Terraform local variable definitions containing real account IDs or tokens
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Environment variables & secrets
.env
.env.*
!.env.example
set-env.ps1
*set-env*.ps1

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts (built in CI/CD before deployment)
dist/

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

